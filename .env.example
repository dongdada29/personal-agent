# Personal Agent 本地配置示例。复制为 .env 前请按需调整；不要在这里保存密钥。

# 数据目录。留空时服务默认使用 ~/.personal-agent；建议正式运行时显式指定到源码目录之外。
# PERSONAL_AGENT_DATA_DIR=/tmp/personal-agent-data

# 访问模式。留空表示 loopback 本机免登录；公网访问必须显式设置为 paired。
PERSONAL_AGENT_AUTH_MODE=

# paired 模式对外固定 HTTPS origin。示例域名仅用于文档，请替换为自己的 HTTPS 入口。
# PERSONAL_AGENT_PUBLIC_ORIGIN=https://agent.example.com

# 仅限本地开发：paired 模式允许 http://localhost origin。正式或公网环境不要设置。
# PERSONAL_AGENT_INSECURE_LOCALHOST=1

# 测试专用：启用真实 loopback SSE socket。日常运行不需要设置。
# PERSONAL_AGENT_SSE_REAL_SOCKETS=1

# 模型凭据由 Claude 引擎读取本机原生配置；本项目不需要、也不应该在 .env 中放任何密钥。
